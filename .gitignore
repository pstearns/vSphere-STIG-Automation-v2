# =========================================================================
# VMware STIG Orchestration .gitignore
# =========================================================================

# OS & Editor Files
.DS_Store
.vscode/
*.swp

# Ignore active production secrets
conf/*/inputs.yml
conf/*/answers.xml
conf/vault.key
conf/.creds.json.encrypted
conf/global_config.yml

# Ignore all systemd environment overrides
*.env
!example.env

# Credentials & Vaults (CRITICAL)
conf/vault.key
conf/.creds.json.encrypted
*.key
*.encrypted
*.pem
*.pfx

# Reports, Logs, and Output
reports/
logs/
*.log
*Transcript*.txt
/tmp/*.ckl
*_temp.ckl
/stigman-watcher/inboxes/

# Raw InSpec JSON Data
*.json
!conf/*.json

# PowerShell Specific
*.ps1xml
*.clixml
*.psc1
*.pssc