# =========================================================================
# VMware STIG Orchestration .gitignore
# =========================================================================

# OS & Editor Files
.DS_Store
.vscode/
*.swp

#Config Files
.env
*.env
*secret*
conf/*.yml
conf/*.xml

# EXCEPT this specific example file (force tracking)
!example.env
!answers_example.xml
!inputs_example.yml

# Credentials & Vaults (CRITICAL)
conf/vault.key
conf/.creds.json.encrypted
*.key
*.encrypted
*.pem
*.pfx

# Reports, Logs, and Output
reports/
logs/
*.log
*Transcript*.txt
/tmp/*.ckl
*_temp.ckl

# Raw InSpec JSON Data
*.json
!conf/*.json

# PowerShell Specific
*.ps1xml
*.clixml
*.psc1
*.pssc