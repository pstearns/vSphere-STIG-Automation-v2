WATCHER_ADD_EXISTING=true
WATCHER_API_BASE=https://<STIGMAN_API_URL>/api
WATCHER_AUTHORITY=https://<STIGMAN_API_URL>/kc/realms/stigman
WATCHER_CARGO_DELAY=2000
WATCHER_CARGO_SIZE=25
WATCHER_CLIENT_ID=stig-watcher
WATCHER_CLIENT_SECRET=<PASTE_YOUR_OIDC_SECRET_HERE>
#WATCHER_CLIENT_KEY=
#WATCHER_CLIENT_KEY_PASSPHRASE=
WATCHER_COLLECTION=
WATCHER_CREATE_OBJECTS=true
#WATCHER_IGNORE_GLOBS=**/ignoredDir,**/someDir/ignoredFile
#WATCHER_LOG_FILE=
#WATCHER_LOG_FILE_LEVEL=debug
#WATCHER_PATH=./watched
#WATCHER_PATH=//unc/path
#WATCHER_USE_POLLING=false
#WATCHER_STABILITY_THRESHOLD=5000
WATCHER_MODE=scan
#NODE_EXTRA_CA_CERTS=/usr/share/stigs/orchestration_overlay/stigman-watcher/config/ROOT_CA.crt
